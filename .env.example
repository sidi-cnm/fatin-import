# Copier ce fichier en .env puis remplir les valeurs. Ne jamais publier le .env.

# Clé secrète partagée avec le serveur FATIN (en-tête X-API-Key). Choisir une longue chaîne aléatoire.
SERVICE_API_KEY=changez-moi

# Fournisseur par défaut : gemini | mistral | openai | anthropic | fake (fake = exemple U01-L01, sans IA)
AI_PROVIDER=fake

# Google Gemini (clé gratuite sur Google AI Studio). Vérifier dans AI Studio quel modèle Flash est gratuit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Modèle de secours si le principal est surchargé (vide = aucun)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Mistral (offre gratuite « Experiment », sur la console Mistral)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest
# ocr = texte seulement (les dessins sont perdus) ; vision = images des pages (comme Gemini)
MISTRAL_MODE=ocr

# OpenAI GPT (clé sur platform.openai.com, compte prépayé)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Anthropic Claude (clé sur console.anthropic.com / platform.claude.com, compte prépayé)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Limites
MAX_FILE_MB=60
REQUEST_TIMEOUT_SECONDS=180
# Si le serveur d'IA est surchargé : nombre d'essais, et attente avant le 2e essai (puis x2 à chaque fois)
RETRY_ATTEMPTS=4
RETRY_WAIT_SECONDS=15
# Découpage automatique d'un livre : pause entre deux appels (les offres gratuites limitent les appels par minute)
PAUSE_BETWEEN_CALLS_SECONDS=4
# Création des unités : nombre de leçons par unité (minimum, maximum)
MIN_LESSONS_PER_UNIT=3
MAX_LESSONS_PER_UNIT=10

# Simulation du CMS (http://localhost:8000/cms) : dossier où « enregistrer dans la base »
CMS_SAVE_DIR=resultats/cms
# En PRODUCTION : false. La page de test /cms et l'enregistrement en fichiers sont coupés ;
# /api/cms/check-outline/ (revérifier le plan) reste disponible pour le vrai CMS.
CMS_SIMULATION=true
